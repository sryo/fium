#!/usr/bin/env python3
"""fium: check a project against RULES.md. Each finding cites a rule id."""
import argparse, json, re, sys
from pathlib import Path


def finding(rule, level, file, msg, fix):
    return {"rule": rule, "level": level, "file": file, "msg": msg, "fix": fix}


def check_files(root):
    out = []
    if not (root / "AGENTS.md").exists():
        fix = "git mv AGENT.md AGENTS.md" if (root / "AGENT.md").exists() else "write AGENTS.md (templates/AGENTS.md)"
        out.append(finding("F1", "error", "AGENTS.md", "missing", fix))
    claude = root / "CLAUDE.md"
    if not (claude.is_symlink() and claude.readlink().name == "AGENTS.md"):
        out.append(finding("F2", "error", "CLAUDE.md", "not a symlink to AGENTS.md",
                           "move anything unique into AGENTS.md, then: ln -sf AGENTS.md CLAUDE.md"))
    for rule, name in (("F3", "README.md"), ("F4", "GOALS.md"), ("F5", "LICENSE")):
        if not (root / name).exists():
            out.append(finding(rule, "error", name, "missing", f"copy templates/{name}"))
    return out


GOAL_SECTIONS = [
    ("purpose", r"^## What .+ is for"),
    ("never traded", r"^## .*never trad"),
    ("goals", r"^## Goals"),
    ("how we know", r"^## How we know"),
    ("non-goals", r"^## Non-goals"),
]


def check_goals(root):
    p = root / "GOALS.md"
    if not p.exists():
        return []
    text = p.read_text()
    out = []
    missing = [n for n, rx in GOAL_SECTIONS if not re.search(rx, text, re.M | re.I)]
    if missing:
        out.append(finding("G1", "error", "GOALS.md", "missing sections: " + ", ".join(missing), "follow templates/GOALS.md"))
    m = re.search(r"^## How we know\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    goals = set(re.findall(r"^(\d+)\. ", text.split("## How we know")[0], re.M))
    if m:
        covered = {c.split("|")[1].strip() for c in m.group(1).splitlines() if c.startswith("|")}
        for g in sorted(goals - covered):
            out.append(finding("G2", "error", "GOALS.md", f"goal {g} has no row in How we know", "add: | {g} | metric | command or file |".replace("{g}", g)))
        rows = [r for r in m.group(1).splitlines() if r.startswith("|")][2:]
        for r in rows:
            cells = [c.strip() for c in r.strip("|").split("|")]
            if len(cells) < 3 or not cells[1] or not cells[-1]:
                out.append(finding("G2", "error", "GOALS.md", f"metric row without a metric or a where: {r.strip()}",
                                   "name the command or file that measures it"))
    return out


def repo_name(root):
    import subprocess
    url = subprocess.run(["git", "-C", str(root), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    return (url.rstrip("/").split("/")[-1].removesuffix(".git") if url else root.name).lower()


def check_readme(root):
    p = root / "README.md"
    if not p.exists():
        return []
    text = p.read_text()
    name = repo_name(root)
    out = []
    lines = text.splitlines()
    if not lines or lines[0].strip() not in (f"# {name}", f"# /{name}"):
        out.append(finding("R1", "error", "README.md", f"first line should be '# {name}'", f"set the title to '# {name}'"))
    opener = next((l for l in lines[1:] if l.strip()), "")
    if not re.match(rf"^/?{re.escape(name)}\b", opener, re.I):
        out.append(finding("R2", "warn", "README.md", "opener should start with the plain name and say what it does",
                           f"'{name} does X.' in one sentence"))
    for sec in ("Install", "Use"):
        if not re.search(rf"^## {sec}\b", text, re.M):
            out.append(finding("R3", "error", "README.md", f"no '## {sec}' section", f"add ## {sec}"))
    if re.search(r"shields\.io|badge", text, re.I):
        out.append(finding("R4", "warn", "README.md", "badges", "remove badges"))
    dev = re.findall(r"^## (Development|Contributing|Architecture|Building|Build|How it works|Internals)\b", text, re.M | re.I)
    if dev:
        out.append(finding("R5", "warn", "README.md", "sections for builders, not users: " + ", ".join(dev),
                           "move build, dev and internals to AGENTS.md; the README says why it's useful and how to use it"))
    return out


def check(root):
    root = Path(root).resolve()
    return check_files(root) + check_goals(root) + check_readme(root)


# ---- price: judge a change's cost against a baseline ----
# A run file: {"metrics": {name: {"dir": "lower"|"higher", "kind": time|tokens|count|bytes|quality|loc, "samples": [...]}},
#              "limits": {name: hard_max_or_min}}. Deterministic kinds (count, bytes, quality, loc) judge any move;
# noisy kinds (time, tokens) judge the bootstrap 95% range of the run/base median ratio against 1 ± rel.
# A limit kind is judged only against its limit. A move no bigger than the noise file's abs for that metric is same.
import math, random, statistics, subprocess

MIN_N = 5
NOISY = {"time", "tokens"}
DEFAULT_REL = 0.10
TRAILER = re.compile(r"^(Price|Bench-Accepted):\s*([^;]+);\s*([^;]+?)\s*->\s*([^;]+?);\s*buys:\s*(.*?)(?:;\s*tried:\s*(.*?))?;\s*owner:\s*(.+)$", re.M)


def lcg(seed):
    while True:
        seed = (seed * 1664525 + 1013904223) & 0xFFFFFFFF
        yield seed / 4294967296


def ratio_range(base, run, n=2000):
    # Paired reps (run alternately with the base) are judged on their rep-by-rep ratios: the bootstrap range of
    # the median ratio, in logs, with Lede's seeded generator, so the same run gets the same verdict anywhere.
    # A base rep of 0 counts as doubled when the run's isn't 0, unchanged when it is.
    if len(base) == len(run):
        ratios = [r / b if b > 0 else 2 if r > 0 else 1 for b, r in zip(base, run)]
        logs = [math.log(x) if x > 0 else -math.inf for x in ratios]
        rand = lcg(42)
        meds = sorted(statistics.median(logs[int(next(rand) * len(logs))] for _ in logs) for _ in range(n))
        return math.exp(meds[int(n * 0.025)]), math.exp(meds[math.ceil(n * 0.975) - 1])
    rng = random.Random(7)
    out = []
    for _ in range(n):
        b, r = [rng.choice(base) for _ in base], [rng.choice(run) for _ in run]
        mb = statistics.median(b)
        out.append(statistics.median(r) / mb if mb else float("inf"))
    out.sort()
    return out[int(0.025 * n)], out[int(0.975 * n) - 1]


def judge(name, base, run, rel, limit, priced, abs_=0):
    if run is None:
        return {"metric": name, "verdict": "missing"}
    lower = base.get("dir", "lower") == "lower"
    b, r = base["samples"], run["samples"]
    mb, mr = statistics.median(b), statistics.median(r)
    row = {"metric": name, "base": mb, "run": mr}
    if limit is not None and ((mr > limit) if lower else (mr < limit)):
        return {**row, "verdict": "limit", "limit": limit}
    noisy = base.get("noisy", base.get("kind", "time") in NOISY)
    if base.get("kind") == "limit":
        v = "same"
    elif abs(mr - mb) <= abs_:
        v = "same"
    elif noisy and min(len(b), len(r)) < MIN_N:
        # Too few reps for a range (agent evals): judge the median against the band, and say so.
        point = mr / mb if mb else float("inf")
        if not lower:
            point = 1 / point if point else float("inf")
        v = "worse" if point > 1 + rel else "better" if point < 1 - rel else "same"
        row["low_n"] = True
    elif noisy:
        lo, hi = ratio_range(b, r)
        row["range"] = [round(lo, 4), round(hi, 4)]
        if not lower:
            lo, hi = 1 / hi if hi else float("inf"), 1 / lo if lo else float("inf")
        if lo > 1 + rel:
            v = "worse"
        elif hi < 1 - rel:
            v = "better"
        elif lo >= 1 - rel and hi <= 1 + rel:
            v = "same"
        else:
            v = "inconclusive"
    else:
        worse = mr > mb if lower else mr < mb
        better = mr < mb if lower else mr > mb
        v = "worse" if worse else "better" if better else "same"
    # An exact metric's prices cover only the growth they add up to; a noisy one's cover it while it lasts.
    if v == "worse" and name in priced and (noisy or abs(mr - mb) <= priced[name]):
        v = "priced"
    return {**row, "verdict": v}


def price_compare(base_path, run_path, noise_path=None, priced=None):
    base, run = json.load(open(base_path)), json.load(open(run_path))
    noise = json.load(open(noise_path)) if noise_path else {}
    rel, abs_ = noise.get("rel", {}), noise.get("abs", {})
    limits = {**base.get("limits", {}), **run.get("limits", {})}
    return [judge(n, m, run["metrics"].get(n), rel.get(n, DEFAULT_REL), limits.get(n), priced or {}, abs_.get(n, 0))
            for n, m in base["metrics"].items()]


PRICING_FILE = re.compile(r"(^|/)(noise\.json|test_[^/]*|[^/]*[._]test\.[^/]*)$")


def only_pricing_since(repo, sha):
    # A price is committed after the run it prices (K4), so commits that only carry a trailer
    # and touch noise or test files leave the measured code as the run saw it.
    git = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True)
    revs = git("rev-list", f"{sha}..HEAD")
    if revs.returncode or git("merge-base", "--is-ancestor", sha, "HEAD").returncode:
        return False
    for rev in revs.stdout.split():
        files = git("diff-tree", "--no-commit-id", "--name-only", "-r", rev).stdout.split()
        if not TRAILER.search(git("log", "-1", "--format=%B", rev).stdout) or not all(PRICING_FILE.search(f) for f in files):
            return False
    return True


def stale_row(run_path, repo):
    # A run says which commit it measured, so an old or dirty run can't pass for this change (K1, K2).
    run = json.load(open(run_path))
    sha = run.get("commit")
    if not sha:
        return {"metric": "(commit)", "verdict": "unstamped"}
    head = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    if len(sha) < 7 or (not head.startswith(sha) and not only_pricing_since(repo, sha)) or run.get("dirty"):
        return {"metric": "(commit)", "base": head[:12] or None, "run": sha[:12] + ("+dirty" if run.get("dirty") else ""), "verdict": "stale"}
    return None


def price_ledger(repo, since=None):
    rng = f"{since}..HEAD" if since else "HEAD"
    log = subprocess.run(["git", "-C", str(repo), "log", "--format=%h%x00%B%x01", rng], capture_output=True, text=True).stdout
    rows = []
    for entry in log.split("\x01"):
        if "\x00" not in entry:
            continue
        sha, body = entry.strip().split("\x00", 1)
        for m in TRAILER.finditer(body):
            rows.append({"commit": sha, "metric": m[2].strip(), "before": m[3].strip(), "after": m[4].strip(),
                         "buys": m[5].strip(), "tried": (m[6] or "").strip(), "owner": m[7].strip()})
    return rows



# ---- survey: what the repos under a folder say about the rules. It reads; it never writes. ----
HOME = Path(__file__).resolve().parent
SURVEYED = ("AGENTS.md", "GOALS.md", "README.md")


def headings(text):
    return {h.strip().lower() for h in re.findall(r"^## (.+)$", text, re.M)}


def survey(base, min_repos=3):
    repos = sorted(d for d in Path(base).expanduser().iterdir() if (d / ".git").exists())
    ids = re.findall(r"^- \*\*([A-Z]\d+)", (HOME / "RULES.md").read_text(), re.M)
    # A template heading's NAME matches any project name.
    known = {f: [re.compile("^" + re.escape(h).replace("name", ".+") + "$") for h in headings((HOME / "templates" / f).read_text())]
             for f in SURVEYED}
    failures, adds, cited, passing = {}, {f: {} for f in SURVEYED}, {}, 0
    for d in repos:
        fs = check(d)
        passing += not any(f["level"] == "error" for f in fs)
        for r in {f["rule"] for f in fs}:
            failures[r] = failures.get(r, 0) + 1
        for f in SURVEYED:
            p = d / f
            for h in headings(p.read_text()) if p.is_file() else ():
                if not any(rx.match(h) for rx in known[f]):
                    adds[f][h] = adds[f].get(h, 0) + 1
        log = subprocess.run(["git", "-C", str(d), "log", "--format=%B"], capture_output=True, text=True).stdout
        for rid in ids:
            if re.search(rf"\b{rid}\b", log):
                cited[rid] = cited.get(rid, 0) + 1
    drift = {f: {h: n for h, n in sorted(hs.items(), key=lambda x: -x[1]) if n >= min_repos} for f, hs in adds.items()}
    return {"repos": len(repos), "passing": passing,
            "failures": dict(sorted(failures.items(), key=lambda x: -x[1])),
            "drift": {f: hs for f, hs in drift.items() if hs},
            "cited": dict(sorted(cited.items(), key=lambda x: -x[1])),
            "uncited": [r for r in ids if r not in cited]}


def survey_main(a):
    s = survey(a.path, a.min)
    if a.json:
        return print(json.dumps(s))
    print(f"{s['passing']}/{s['repos']} repos pass fium check")
    for label, d in [("repos failing each rule", s["failures"]), ("repos citing each rule", s["cited"]),
                     *((f"{f} sections the template lacks", hs) for f, hs in s["drift"].items())]:
        print(f"{label}: " + (", ".join(f"{k} {n}" for k, n in d.items()) or "none"))
    print("never cited: " + (", ".join(s["uncited"]) or "none"))


def main():
    ap = argparse.ArgumentParser(prog="fium")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("path", nargs="?", default=".")
    c.add_argument("--all", action="store_true", help="check every git repo directly under path")
    c.add_argument("--json", action="store_true")
    sv = sub.add_parser("survey", help="report rule failures, template drift and rule citations across the repos under a folder")
    sv.add_argument("path", nargs="?", default="~/Documents")
    sv.add_argument("--min", type=int, default=3, help="repos a section must appear in to count as drift")
    sv.add_argument("--json", action="store_true")
    pr = sub.add_parser("price").add_subparsers(dest="pcmd", required=True)
    pc = pr.add_parser("compare", help="judge a run against a baseline")
    pc.add_argument("base"); pc.add_argument("run")
    pc.add_argument("--noise", help="A/A noise file: {rel: {metric: fraction}, abs: {metric: amount}}")
    pc.add_argument("--price", action="append", default=[], help="metric the owner accepted a cost on")
    pc.add_argument("--since", help="also accept metrics priced by Price: trailers in since..HEAD")
    pc.add_argument("--repo", help="repo whose Price: trailers --since reads (default: the current directory's)")
    pc.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "price":
        return price_main(a)
    if a.cmd == "survey":
        return survey_main(a)
    base = Path(a.path).expanduser()
    if a.all:
        res = {d.name: check(d) for d in sorted(base.iterdir()) if (d / ".git").exists()}
    else:
        res = check(base)
    if a.json:
        print(json.dumps(res))
    else:
        for repo, fs in (res.items() if a.all else [(base.resolve().name, res)]):
            errs = sum(f["level"] == "error" for f in fs)
            print(f"{repo}: {errs} errors, {len(fs) - errs} warnings")
            for f in fs:
                print(f"  {f['level']} {f['rule']} {f['file']}: {f['msg']} -> {f['fix']}")
    flat = [f for fs in res.values() for f in fs] if a.all else res
    sys.exit(1 if any(f["level"] == "error" for f in flat) else 0)


def price_main(a):
    num = lambda x: float(x.replace(",", ""))
    priced = {m: math.inf for m in a.price}
    for r in price_ledger(a.repo or ".", a.since) if a.since else []:
        try:
            priced[r["metric"]] = priced.get(r["metric"], 0) + abs(num(r["after"]) - num(r["before"]))
        except ValueError:
            priced[r["metric"]] = math.inf
    rows = price_compare(a.base, a.run, a.noise, priced)
    stale = stale_row(a.run, a.repo or ".")
    rows += [stale] if stale else []
    if a.json:
        print(json.dumps(rows))
    else:
        for r in rows:
            print(f"{r['verdict'] + ('?' if r.get('low_n') else ''):>12}  {r['metric']}: {r.get('base')} -> {r.get('run')}" + (f"  range {r['range']}" if "range" in r else ""))
    vs = {r["verdict"] for r in rows}
    if stale and not a.json:
        fix = ("stamp the run with \"commit\": git rev-parse HEAD and \"dirty\": whether git status --porcelain is non-empty"
               if stale["verdict"] == "unstamped" else "commit, then rerun the bench on HEAD")
        print(f"  {stale['verdict']}: {fix}", file=sys.stderr)
    sys.exit(1 if vs & {"worse", "limit", "missing", "stale"} else 3 if "inconclusive" in vs else 0)


if __name__ == "__main__":
    main()
