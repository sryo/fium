#!/usr/bin/env python3
"""fium: check a project against RULES.md. Each finding cites a rule id."""
import argparse, json, os, re, sys
from pathlib import Path


def finding(rule, level, file, msg, fix):
    return {"rule": rule, "level": level, "file": file, "msg": msg, "fix": fix}


def check_files(root):
    out = []
    if not (root / "AGENTS.md").exists():
        fix = "git mv AGENT.md AGENTS.md" if (root / "AGENT.md").exists() else "write AGENTS.md (templates/AGENTS.md)"
        out.append(finding("F1", "error", "AGENTS.md", "missing", fix))
    claude = root / "CLAUDE.md"
    if not (claude.is_symlink() and claude.readlink().name == "AGENTS.md"):
        out.append(finding("F2", "error", "CLAUDE.md", "not a symlink to AGENTS.md",
                           "move anything unique into AGENTS.md, then: ln -sf AGENTS.md CLAUDE.md"))
    for rule, name in (("F3", "README.md"), ("F4", "GOALS.md"), ("F5", "LICENSE")):
        if not (root / name).exists():
            out.append(finding(rule, "error", name, "missing", f"copy templates/{name}"))
    return out


GOAL_SECTIONS = [
    ("purpose", r"^## What .+ is for"),
    ("never traded", r"^## .*never trad"),
    ("goals", r"^## Goals"),
    ("how we know", r"^## How we know"),
    ("non-goals", r"^## Non-goals"),
]


def check_goals(root):
    p = root / "GOALS.md"
    if not p.exists():
        return []
    text = p.read_text()
    out = []
    missing = [n for n, rx in GOAL_SECTIONS if not re.search(rx, text, re.M | re.I)]
    if missing:
        out.append(finding("G1", "error", "GOALS.md", "missing sections: " + ", ".join(missing), "follow templates/GOALS.md"))
    m = re.search(r"^## How we know\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    goals = set(re.findall(r"^(\d+)\. ", text.split("## How we know")[0], re.M))
    if m:
        covered = {c.split("|")[1].strip() for c in m.group(1).splitlines() if c.startswith("|")}
        for g in sorted(goals - covered):
            out.append(finding("G2", "error", "GOALS.md", f"goal {g} has no row in How we know", "add: | {g} | metric | command or file |".replace("{g}", g)))
        rows = [r for r in m.group(1).splitlines() if r.startswith("|")][2:]
        for r in rows:
            cells = [c.strip() for c in r.strip("|").split("|")]
            if len(cells) < 3 or not cells[1] or not cells[-1]:
                out.append(finding("G2", "error", "GOALS.md", f"metric row without a metric or a where: {r.strip()}",
                                   "name the command or file that measures it"))
    return out


def repo_name(root):
    import subprocess
    url = subprocess.run(["git", "-C", str(root), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    return (url.rstrip("/").split("/")[-1].removesuffix(".git") if url else root.name).lower()


def check_readme(root):
    p = root / "README.md"
    if not p.exists():
        return []
    text = p.read_text()
    name = repo_name(root)
    out = []
    lines = text.splitlines()
    # A logo (HTML or an image) may open the README; the title, if any, follows it.
    logo = next((i for i, l in enumerate(lines) if not re.match(r"\s*(<|!\[|$)", l)), len(lines))
    lines = lines[logo:]
    titled = bool(lines) and lines[0].strip() in (f"# {name}", f"# /{name}")
    if not titled and not logo:
        out.append(finding("R1", "error", "README.md", f"first line should be '# {name}'", f"set the title to '# {name}'"))
    opener = next((l for l in lines[titled:] if l.strip()), "")
    if not re.match(rf"^/?{re.escape(name)}\b", opener, re.I):
        out.append(finding("R2", "warn", "README.md", "opener should start with the plain name and say what it does",
                           f"'{name} does X.' in one sentence"))
    for sec in ("Install", "Use"):
        if not re.search(rf"^## {sec}\b", text, re.M):
            out.append(finding("R3", "error", "README.md", f"no '## {sec}' section", f"add ## {sec}"))
    if re.search(r"shields\.io|badge", text, re.I):
        out.append(finding("R4", "warn", "README.md", "badges", "remove badges"))
    out += readme_drift(root, name, text)
    dev = re.findall(r"^## (Development|Contributing|Architecture|Building|Build|How it works|Internals)\b", text, re.M | re.I)
    if dev:
        out.append(finding("R5", "warn", "README.md", "sections for builders, not users: " + ", ".join(dev),
                           "move build, dev and internals to AGENTS.md; the README says why it's useful and how to use it"))
    return out


IMPORT = re.compile(r"^\s*@[~./\w-]+\S*\s*$")


def check_agent_docs(root):
    out = []
    agents = root / "AGENTS.md"
    if agents.is_file() and not re.search(r"^## Test\b", agents.read_text(), re.M):
        out.append(finding("F7", "error", "AGENTS.md", "no '## Test' section", "add ## Test with the command that runs the tests"))
    for p in [agents, *sorted(root.glob("SKILL.md")), *sorted(root.glob("skills/*/SKILL.md"))]:
        if not p.is_file():
            continue
        # Fenced code may hold decorators or handles; only prose lines can be imports.
        prose = re.sub(r"^```.*?^```", "", p.read_text(), flags=re.M | re.S)
        bad = [l.strip() for l in prose.splitlines() if IMPORT.match(l)]
        if bad:
            out.append(finding("F6", "error", str(p.relative_to(root)), "@ imports: " + ", ".join(bad),
                               "inline the text, or name the file as a plain path to read; an import that stops resolving drops its text silently"))
    return out


def check_memory(root):
    # Claude names a project's folder after its path with every other character as "-".
    conf = Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser()
    mem = conf / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(root)) / "memory"
    out = []
    for p in sorted(mem.glob("*.md")) if mem.is_dir() else []:
        m = re.match(r"---\n(.*?)\n---", p.read_text(), re.S)
        if p.name != "MEMORY.md" and not (m and re.search(r"^name:", m[1], re.M) and re.search(r"^description:", m[1], re.M)):
            out.append(finding("M1", "error", str(p), "no name and description frontmatter",
                               "open with ---, name: <slug>, description: <one line>, ---"))
    return out


def own_checks(root):
    # A project's checks fium can't know about, one shell command per line, run from its root (F8).
    p = root / "bench" / "checks"
    out = []
    for cmd in [l.strip() for l in p.read_text().splitlines() if l.strip() and not l.startswith("#")] if p.is_file() else []:
        r = subprocess.run(cmd, shell=True, cwd=root, capture_output=True, text=True)
        if r.returncode:
            tail = (r.stderr or r.stdout).strip().splitlines()[-1:] or [f"exit {r.returncode}"]
            out.append(finding("F8", "error", "bench/checks", f"{cmd}: {tail[0]}", f"run it in {root.name} and fix what it reports"))
    return out


FENCE = re.compile(r"^```.*?^```", re.M | re.S)
CODE_EXT = {".py", ".js", ".mjs", ".cjs", ".ts", ".sh", ".swift", ".go", ".rs", ".lua", ""}
SKIP_DIRS = {".git", "node_modules", "test", "tests", "docs", ".build", "dist", "build", "vendor"}


def words_in(p):
    # What a CLI can be called with: quoted literals (argparse names, case "verb") and shell `verb)` arms.
    src = p.read_text(errors="replace")
    return set(re.findall(r"[\"'`](-{0,2}\w[\w-]*)[\"'`=]", src)) | set(re.findall(r"^\s*\"?([\w-]+)\"?\)", src, re.M))


def cli_words(root, name, shown):
    extra = root / "bench" / "readme-cli"
    words = set(extra.read_text().split()) if extra.is_file() else set()
    for p in (root / name, root / "bin" / name):
        words |= words_in(p) if p.is_file() else set()
    if shown <= words:
        return words
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not x.startswith(".")]
        words |= {w for f in files if Path(f).suffix in CODE_EXT and Path(d, f).stat().st_size < 1_000_000 for w in words_in(Path(d, f))}
    return words


def readme_drift(root, name, text):
    # R6: the README says only what a user sees and types, and what it shows under Use still exists.
    out, prose = [], FENCE.sub("", text)
    env = sorted(set(re.findall(r"\$?\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\b", prose)))
    if env:
        out.append(finding("R6", "error", "README.md", "names env vars: " + ", ".join(env),
                           "say what the user does instead, or move the variable to AGENTS.md"))
    use = re.search(r"^## Use\b(.*?)(?=^## |\Z)", text, re.M | re.S)
    shown = set()
    for block in re.findall(r"^```.*?\n(.*?)^```", use[1] if use else "", re.M | re.S):
        for l in block.splitlines():
            words = l.strip().removeprefix("$ ").split()
            if words and re.fullmatch(rf"(\S*/)?{re.escape(name)}", words[0]):
                args = [w.split("=")[0] for w in words[1:]]
                shown |= {w for w in args if w.startswith("-")} | ({args[0]} if args and re.fullmatch(r"[a-z][\w-]*", args[0]) else set())
    missing = sorted(shown - cli_words(root, name, shown)) if shown else []
    if missing:
        out.append(finding("R6", "error", "README.md", "Use shows what the CLI doesn't have: " + ", ".join(missing),
                           "update the README, or list them in bench/readme-cli if the source names them another way"))
    for what, rx in (("timings", r"\b\d+(?:\.\d+)? ?(?:ms|s|Hz|minutes?)\b"), ("source paths", r"\bSources/|\b[\w/.-]+\.(?:swift|py)\b")):
        hits = sorted(set(re.findall(rx, prose)))
        if hits:
            out.append(finding("R6", "warn", "README.md", f"{what} in prose: " + ", ".join(hits),
                               "describe what the user sees; numbers and internals go stale in AGENTS.md or the code"))
    return out


def check(root):
    root = Path(root).resolve()
    return check_files(root) + check_goals(root) + check_readme(root) + check_agent_docs(root) + check_memory(root)


# ---- price: judge a change's cost against a baseline ----
# A run file: {"metrics": {name: {"dir": "lower"|"higher", "kind": time|tokens|count|bytes|quality|loc, "samples": [...]}},
#              "limits": {name: hard_max_or_min}}. Deterministic kinds (count, bytes, quality, loc) judge any move;
# noisy kinds (time, tokens) judge the bootstrap 95% range of the run/base median ratio against 1 ± rel.
# A limit kind is judged only against its limit. A move no bigger than the noise file's abs for that metric is same.
import math, random, statistics, subprocess
from fnmatch import fnmatch

MIN_N = 5
NOISY = {"time", "tokens"}
DEFAULT_REL = 0.10
TRAILER = re.compile(r"^(Price|Bench-Accepted):\s*([^;]+);\s*([^;]+?)\s*->\s*([^;]+?);\s*buys:\s*(.*?)(?:;\s*tried:\s*(.*?))?;\s*owner:\s*(.+)$", re.M)


def lcg(seed):
    while True:
        seed = (seed * 1664525 + 1013904223) & 0xFFFFFFFF
        yield seed / 4294967296


def ratio_range(base, run, n=2000):
    # Paired reps (run alternately with the base) are judged on their rep-by-rep ratios: the bootstrap range of
    # the median ratio, in logs, with Lede's seeded generator, so the same run gets the same verdict anywhere.
    # A base rep of 0 counts as doubled when the run's isn't 0, unchanged when it is.
    if len(base) == len(run):
        ratios = [r / b if b > 0 else 2 if r > 0 else 1 for b, r in zip(base, run)]
        logs = [math.log(x) if x > 0 else -math.inf for x in ratios]
        rand = lcg(42)
        meds = sorted(statistics.median(logs[int(next(rand) * len(logs))] for _ in logs) for _ in range(n))
        return math.exp(meds[int(n * 0.025)]), math.exp(meds[math.ceil(n * 0.975) - 1])
    rng = random.Random(7)
    out = []
    for _ in range(n):
        b, r = [rng.choice(base) for _ in base], [rng.choice(run) for _ in run]
        mb = statistics.median(b)
        out.append(statistics.median(r) / mb if mb else float("inf"))
    out.sort()
    return out[int(0.025 * n)], out[int(0.975 * n) - 1]


def judge(name, base, run, rel, limit, priced, abs_=0, cap=(2, 0)):
    if run is None:
        return {"metric": name, "verdict": "missing"}
    lower = base.get("dir", "lower") == "lower"
    b, r = base["samples"], run["samples"]
    mb, mr = statistics.median(b), statistics.median(r)
    row = {"metric": name, "base": mb, "run": mr}
    if limit is not None and ((mr > limit) if lower else (mr < limit)):
        return {**row, "verdict": "limit", "limit": limit}
    noisy = base.get("noisy", base.get("kind", "time") in NOISY)
    if base.get("kind") == "limit":
        v = "same"
    elif abs(mr - mb) <= abs_:
        v = "same"
    elif noisy and min(len(b), len(r)) < MIN_N:
        # Too few reps for a range (agent evals): judge the median against the band, and say so.
        point = mr / mb if mb else float("inf")
        if not lower:
            point = 1 / point if point else float("inf")
        v = "worse" if point > 1 + rel else "better" if point < 1 - rel else "same"
        row["low_n"] = True
    elif noisy:
        lo, hi = ratio_range(b, r)
        row["range"] = [round(lo, 4), round(hi, 4)]
        if not lower:
            lo, hi = 1 / hi if hi else float("inf"), 1 / lo if lo else float("inf")
        if lo > 1 + rel:
            v = "worse"
        elif hi < 1 - rel:
            v = "better"
        elif lo >= 1 - rel and hi <= 1 + rel:
            v = "same"
        else:
            v = "inconclusive"
    else:
        worse = mr > mb if lower else mr < mb
        better = mr < mb if lower else mr > mb
        v = "worse" if worse else "better" if better else "same"
    # The owner's cap (GOALS.md Caps:): 0 only reported, 1 may grow by its slack, 2 needs a price, 3 never grows.
    level, slack = cap
    row["cap"] = level
    if v == "worse" and (level == 0 or (level == 1 and mb and abs(mr - mb) / abs(mb) <= slack)):
        v = "grew"
    # An exact metric's prices cover only the growth they add up to; a noisy one's cover it while it lasts.
    if v == "worse" and level < 3 and name in priced and (noisy or abs(mr - mb) <= priced[name]):
        v = "priced"
    return {**row, "verdict": v}


KIND_LETTER = {"quality": "q", "tokens": "k", "count": "n", "loc": "n", "bytes": "b", "time": "t"}
CAP_LINE = re.compile(r"^\s*(?:Caps|Topes):\s*`?([^`\n]+)`?", re.M | re.I)


def parse_caps(text):
    # "q3 k2 n2 b1 t1 t.js*=2 mount*=1:25": a level per kind letter, then overrides by metric glob.
    kinds, globs = {}, []
    m = CAP_LINE.search(text or "")
    for tok in (m.group(1).split() if m else []):
        key, _, val = tok.rpartition("=") if "=" in tok else (tok[0], "", tok[1:])
        lvl, _, pct = val.partition(":")
        cap = (int(lvl), float(pct) / 100 if pct else 0.10)
        if "=" in tok:
            globs.append((key, cap))
        else:
            kinds[key] = cap
    return kinds, globs


def cap_for(name, kind, caps):
    kinds, globs = caps
    for g, cap in reversed(globs):
        if fnmatch(name, g):
            return cap
    return kinds.get(KIND_LETTER.get(kind, ""), (2, 0))


def goals_text(path):
    p = Path(path).resolve()
    top = git(p if p.is_dir() else p.parent, "rev-parse", "--show-toplevel").stdout.strip()
    p = Path(top) / "GOALS.md" if top else None
    return p.read_text() if p and p.exists() else ""


def price_compare(base_path, run_path, noise_path=None, priced=None, repo=None):
    base, run = json.load(open(base_path)), json.load(open(run_path))
    noise = json.load(open(noise_path)) if noise_path else {}
    rel, abs_ = noise.get("rel", {}), noise.get("abs", {})
    limits = {**base.get("limits", {}), **run.get("limits", {})}
    caps = parse_caps(goals_text(repo or base_path))
    return [judge(n, m, run["metrics"].get(n), rel.get(n, DEFAULT_REL), limits.get(n), priced or {}, abs_.get(n, 0),
                  cap_for(n, m.get("kind", "time"), caps))
            for n, m in base["metrics"].items()]


INERT = ["README.md", "GOALS.md", "AGENTS.md", "CLAUDE.md", "LICENSE", "test/*", "tests/*", "*noise.json", "*baseline.json"]


def git(repo, *a):
    return subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True)


def changed_since(repo, rev):
    # None when rev isn't an ancestor of HEAD: then nothing can be carried over.
    if git(repo, "merge-base", "--is-ancestor", rev, "HEAD").returncode:
        return None
    return git(repo, "diff", "--name-only", rev, "HEAD").stdout.split()


def inert_globs(repo):
    # Agent-facing docs (SKILL.md, references/) change what a run measures, so they are never inert by default.
    p = Path(repo) / "bench" / "inert"
    lines = [l.strip() for l in p.read_text().splitlines() if l.strip() and not l.startswith("#")] if p.exists() else []
    # bench/inert itself is always inert: editing the list can't change what a run measured.
    return ["bench/inert"] + [l for l in lines if l != "!defaults"] + ([] if "!defaults" in lines else INERT)


def stale_row(run_path, repo):
    # A run says which commit it measured, so an old or dirty run can't pass for this change (K1, K2).
    run = json.load(open(run_path))
    sha = run.get("commit")
    if not sha:
        return {"metric": "(commit)", "verdict": "unstamped"}
    head = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    row = {"metric": "(commit)", "base": head[:12] or None, "run": sha[:12] + ("+dirty" if run.get("dirty") else "")}
    if len(sha) < 7 or run.get("dirty"):
        return {**row, "verdict": "stale"}
    if head.startswith(sha):
        return None
    files, globs = changed_since(repo, sha), inert_globs(repo)
    if files is not None and all(any(fnmatch(f, g) for g in globs) for f in files):
        return {**row, "verdict": "carried"}
    return {**row, "verdict": "stale"}


# Every clean, stamped run a compare judges is kept by commit, so a later compare names its base by rev from any cwd.
RUNS = Path(os.environ.get("FIUM_HOME") or "~/.fium").expanduser() / "runs"


def keep_runs(*paths):
    for p in paths:
        run = json.load(open(p))
        if len(run.get("commit") or "") == 40 and not run.get("dirty"):
            RUNS.mkdir(parents=True, exist_ok=True)
            (RUNS / f"{run['commit']}.json").write_text(json.dumps(run))


def find_run(rev, repo):
    if Path(rev).is_file():
        return rev
    sha = git(repo, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}").stdout.strip() or rev
    hits = sorted(RUNS.glob(f"{sha}*.json")) if re.fullmatch(r"[0-9a-f]{4,40}", sha) else []
    if not hits:
        sys.exit(f"fium: {rev} is neither a run file nor a commit with a run in {RUNS}; run the bench on it, or pass the file")
    return str(hits[0])


def price_ledger(repo, since=None):
    rng = f"{since}..HEAD" if since else "HEAD"
    log = subprocess.run(["git", "-C", str(repo), "log", "--format=%h%x00%B%x01", rng], capture_output=True, text=True).stdout
    rows = []
    for entry in log.split("\x01"):
        if "\x00" not in entry:
            continue
        sha, body = entry.strip().split("\x00", 1)
        for m in TRAILER.finditer(body):
            rows.append({"commit": sha, "metric": m[2].strip(), "before": m[3].strip(), "after": m[4].strip(),
                         "buys": m[5].strip(), "tried": (m[6] or "").strip(), "owner": m[7].strip()})
    return rows



# ---- survey: what the repos under a folder say about the rules. It reads; it never writes. ----
HOME = Path(__file__).resolve().parent
SURVEYED = ("AGENTS.md", "GOALS.md", "README.md")


def headings(text):
    return {h.strip().lower() for h in re.findall(r"^## (.+)$", text, re.M)}


def survey(base, min_repos=3):
    repos = sorted(d for d in Path(base).expanduser().iterdir() if (d / ".git").exists())
    ids = re.findall(r"^- \*\*([A-Z]\d+)", (HOME / "RULES.md").read_text(), re.M)
    # A template heading's NAME matches any project name.
    known = {f: [re.compile("^" + re.escape(h).replace("name", ".+") + "$") for h in headings((HOME / "templates" / f).read_text())]
             for f in SURVEYED}
    failures, adds, cited, passing = {}, {f: {} for f in SURVEYED}, {}, 0
    for d in repos:
        fs = check(d)
        passing += not any(f["level"] == "error" for f in fs)
        for r in {f["rule"] for f in fs}:
            failures[r] = failures.get(r, 0) + 1
        for f in SURVEYED:
            p = d / f
            for h in headings(p.read_text()) if p.is_file() else ():
                if not any(rx.match(h) for rx in known[f]):
                    adds[f][h] = adds[f].get(h, 0) + 1
        log = subprocess.run(["git", "-C", str(d), "log", "--format=%B"], capture_output=True, text=True).stdout
        for rid in ids:
            if re.search(rf"\b{rid}\b", log):
                cited[rid] = cited.get(rid, 0) + 1
    drift = {f: {h: n for h, n in sorted(hs.items(), key=lambda x: -x[1]) if n >= min_repos} for f, hs in adds.items()}
    return {"repos": len(repos), "passing": passing,
            "failures": dict(sorted(failures.items(), key=lambda x: -x[1])),
            "drift": {f: hs for f, hs in drift.items() if hs},
            "cited": dict(sorted(cited.items(), key=lambda x: -x[1])),
            "uncited": [r for r in ids if r not in cited]}


def survey_main(a):
    s = survey(a.path, a.min)
    if a.json:
        return print(json.dumps(s))
    print(f"{s['passing']}/{s['repos']} repos pass fium check")
    for label, d in [("repos failing each rule", s["failures"]), ("repos citing each rule", s["cited"]),
                     *((f"{f} sections the template lacks", hs) for f, hs in s["drift"].items())]:
        print(f"{label}: " + (", ".join(f"{k} {n}" for k, n in d.items()) or "none"))
    print("never cited: " + (", ".join(s["uncited"]) or "none"))


def new(name):
    # The templates with NAME filled in, a git repo, and CLAUDE.md -> AGENTS.md (F1-F5).
    root = Path(name).resolve()
    if root.exists():
        sys.exit(f"fium new: {root} exists; pick another name or bring it in with fium check")
    for src in (HOME / "templates").rglob("*"):
        if src.is_file():
            dst = root / src.relative_to(HOME / "templates")
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(src.read_text().replace("NAME", root.name))
    (root / "CLAUDE.md").symlink_to("AGENTS.md")
    git(root, "init", "-q")
    print(f"{root}: write GOALS.md first, then the README (skills/fium/SKILL.md)")


def scope(repo, revs, affects):
    # Which bench tasks a change can move. A file no rule matches could move anything, so it means all.
    rules = json.load(open(affects))["rules"]
    base = revs.split("..")[0]
    files = changed_since(repo, base)
    if files is None:
        return {"tasks": "*", "why": {base: "not an ancestor of HEAD"}}
    tasks, why = set(), {}
    for f in files:
        hit = next((r["tasks"] for r in rules if any(fnmatch(f, g) for g in r["files"])), None)
        if hit is None and any(fnmatch(f, g) for g in inert_globs(repo)):
            hit = "none"
        why[f] = hit if hit is not None else "*"
        if why[f] == "*":
            tasks = "*"
        elif why[f] != "none" and tasks != "*":
            tasks |= set(why[f])
    return {"tasks": tasks if tasks == "*" else sorted(tasks), "why": why}


def scope_main(a):
    affects = a.affects or str(Path(a.repo) / "bench" / "affects.json")
    res = scope(a.repo, a.revs, affects)
    if a.json:
        print(json.dumps(res, indent=2))
    else:
        print("all tasks" if res["tasks"] == "*" else " ".join(res["tasks"]) or "no tasks: nothing a bench measures changed")


def main():
    if sys.argv[1:2] == ["sleep"]:
        os.execv(sys.executable, [sys.executable, str(HOME / "sleep.py"), *sys.argv[2:]])
    ap = argparse.ArgumentParser(prog="fium")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check", help="check a project against the ✓ rules in RULES.md; exit 1 on an error")
    c.add_argument("path", nargs="?", default=".")
    c.add_argument("--all", action="store_true", help="check every git repo directly under path")
    c.add_argument("--json", action="store_true")
    sv = sub.add_parser("survey", help="report rule failures, template drift and rule citations across the repos under a folder")
    sv.add_argument("path", nargs="?", default="~/Documents")
    sv.add_argument("--min", type=int, default=3, help="repos a section must appear in to count as drift")
    sv.add_argument("--json", action="store_true")
    pc = sub.add_parser("compare", help="judge what a change costs: a run against a baseline",
                        epilog="exit 0: lands; 1: worse, limit, missing or stale; 3: inconclusive, rerun with more reps")
    pc.add_argument("base", help="run file, or a commit whose run a past compare kept in ~/.fium/runs"); pc.add_argument("run")
    pc.add_argument("--noise", help="A/A noise file: {rel: {metric: fraction}, abs: {metric: amount}}")
    pc.add_argument("--price", action="append", default=[], help="metric the owner accepted a cost on")
    pc.add_argument("--since", help="also accept metrics priced by Price: trailers in since..HEAD")
    pc.add_argument("--repo", help="repo whose Price: trailers --since reads (default: the current directory's)")
    pc.add_argument("--json", action="store_true")
    sub.add_parser("sleep", help="mine past sessions for failures and keep each fix as a lesson (fium sleep --help)")
    sub.add_parser("new", help="start a project from the templates").add_argument("name")
    sc = sub.add_parser("scope", help="which bench tasks a change can move")
    sc.add_argument("revs", help="base..HEAD")
    sc.add_argument("--repo", default=".")
    sc.add_argument("--affects", help="rules file (default: <repo>/bench/affects.json)")
    sc.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "new":
        return new(a.name)
    if a.cmd == "scope":
        return scope_main(a)
    if a.cmd == "compare":
        return compare_main(a)
    if a.cmd == "survey":
        return survey_main(a)
    base = Path(a.path).expanduser()
    if a.all:
        res = {d.name: check(d) + own_checks(d.resolve()) for d in sorted(base.iterdir()) if (d / ".git").exists()}
    else:
        res = check(base)
    if a.json:
        print(json.dumps(res))
    else:
        for repo, fs in (res.items() if a.all else [(base.resolve().name, res)]):
            errs = sum(f["level"] == "error" for f in fs)
            print(f"{repo}: {errs} errors, {len(fs) - errs} warnings")
            for f in fs:
                print(f"  {f['level']} {f['rule']} {f['file']}: {f['msg']} -> {f['fix']}")
    flat = [f for fs in res.values() for f in fs] if a.all else res
    sys.exit(1 if any(f["level"] == "error" for f in flat) else 0)


def compare_main(a):
    num = lambda x: float(x.replace(",", ""))
    priced = {m: math.inf for m in a.price}
    for r in price_ledger(a.repo or ".", a.since) if a.since else []:
        try:
            priced[r["metric"]] = priced.get(r["metric"], 0) + abs(num(r["after"]) - num(r["before"]))
        except ValueError:
            priced[r["metric"]] = math.inf
    base = find_run(a.base, a.repo or ".")
    rows = price_compare(base, a.run, a.noise, priced, (a.repo or ".") if base != a.base else None)
    keep_runs(base, a.run)
    stale = stale_row(a.run, a.repo or ".")
    rows += [stale] if stale else []
    if a.json:
        print(json.dumps(rows))
    else:
        for r in rows:
            print(f"{r['verdict'] + ('?' if r.get('low_n') else ''):>12}  {r['metric']}: {r.get('base')} -> {r.get('run')}" + (f"  range {r['range']}" if "range" in r else ""))
    vs = {r["verdict"] for r in rows}
    if stale and not a.json:
        fix = ("stamp the run with \"commit\": git rev-parse HEAD and \"dirty\": whether git status --porcelain is non-empty"
               if stale["verdict"] == "unstamped" else
               "only inert files (bench/inert) changed since the run, so its numbers stand" if stale["verdict"] == "carried" else
               "commit, then rerun the bench on HEAD (or list the changed files in bench/inert if no bench reads them)")
        print(f"  {stale['verdict']}: {fix}", file=sys.stderr)
    sys.exit(1 if vs & {"worse", "limit", "missing", "stale"} else 3 if "inconclusive" in vs else 0)


if __name__ == "__main__":
    main()
