#!/usr/bin/env python3
"""fium: check a project against RULES.md, price its changes, and read across repos. Each finding cites a rule id."""
import argparse, json, os, sys
from pathlib import Path

HOME = Path(__file__).resolve().parent
sys.path.insert(0, str(HOME))
from check import check, own_checks  # noqa: E402
from compare import DEFAULT_REL, compare_main, noise, scope_main  # noqa: E402
from repos import grep_main, new, status_main, survey_main  # noqa: E402


def main():
    if sys.argv[1:2] == ["sleep"]:
        os.execv(sys.executable, [sys.executable, str(HOME / "sleep.py"), *sys.argv[2:]])
    ap = argparse.ArgumentParser(prog="fium")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check", help="check a project against the ✓ rules in RULES.md; exit 1 on an error")
    c.add_argument("path", nargs="?", default=".")
    c.add_argument("--all", action="store_true", help="check every git repo directly under path")
    c.add_argument("--json", action="store_true")
    sv = sub.add_parser("survey", help="report rule failures, template drift and rule citations across the repos under a folder")
    sv.add_argument("path", nargs="?", default="~/Documents")
    sv.add_argument("--min", type=int, default=3, help="repos a section must appear in to count as drift")
    sv.add_argument("--json", action="store_true")
    pc = sub.add_parser("compare", help="judge what a change costs: a run against a baseline",
                        epilog="exit 0: lands; 1: worse, limit, missing or stale; 3: inconclusive, rerun with more reps")
    pc.add_argument("base", help="run file, or a commit whose run a past compare kept in ~/.fium/runs"); pc.add_argument("run")
    pc.add_argument("--noise", help="A/A noise file: {rel: {metric: fraction}, abs: {metric: amount}}")
    pc.add_argument("--price", action="append", default=[], help="metric the owner accepted a cost on")
    pc.add_argument("--since", help="also accept metrics priced by Price: trailers in since..HEAD")
    pc.add_argument("--repo", help="repo whose Price: trailers --since reads (default: the current directory's)")
    pc.add_argument("--json", action="store_true")
    ns = sub.add_parser("noise", help="write noise.json for compare --noise from an A/A run, to stdout")
    ns.add_argument("base"); ns.add_argument("run")
    ns.add_argument("--min", type=float, default=DEFAULT_REL, help="the least rel any metric gets (default 0.10)")
    ns.add_argument("--abs", action="append", default=[], metavar="METRIC=AMOUNT",
                    help="a move this small is same; METRIC may be a glob, a later one wins")
    sub.add_parser("sleep", help="mine past sessions for failures and keep each fix as a lesson (fium sleep --help)")
    sub.add_parser("new", help="start a project from the templates").add_argument("name")
    sc = sub.add_parser("scope", help="which bench tasks a change can move")
    sc.add_argument("revs", help="base..HEAD")
    sc.add_argument("--repo", default=".")
    sc.add_argument("--affects", help="rules file (default: <repo>/bench/affects.json)")
    sc.add_argument("--json", action="store_true")
    st = sub.add_parser("status", help="each repo's base branch, dirty files, other branches and worktrees; never writes")
    st.add_argument("path", nargs="?", default="~/Documents")
    st.add_argument("--campaign", help="~/.fium/campaigns/<name>.json: rerun its branches' ## Test commands and print cleanup for its merged ones")
    st.add_argument("--json", action="store_true")
    gp = sub.add_parser("grep", help="search every repo under a folder at its base branch, not at a worktree's")
    gp.add_argument("pattern"); gp.add_argument("path", nargs="?", default="~/Documents")
    a = ap.parse_args()
    if a.cmd == "status":
        return status_main(a)
    if a.cmd == "grep":
        return grep_main(a)
    if a.cmd == "new":
        return new(a.name)
    if a.cmd == "scope":
        return scope_main(a)
    if a.cmd == "compare":
        return compare_main(a)
    if a.cmd == "noise":
        globs = [(g, float(v)) for g, _, v in (x.rpartition("=") for x in a.abs)]
        return print(json.dumps(noise(a.base, a.run, a.min, globs), indent=2, ensure_ascii=False))
    if a.cmd == "survey":
        return survey_main(a)
    base = Path(a.path).expanduser()
    if a.all:
        res = {d.name: check(d) + own_checks(d.resolve()) for d in sorted(base.iterdir()) if (d / ".git").exists()}
    else:
        res = check(base)
    if a.json:
        print(json.dumps(res))
    else:
        for repo, fs in (res.items() if a.all else [(base.resolve().name, res)]):
            errs = sum(f["level"] == "error" for f in fs)
            print(f"{repo}: {errs} errors, {len(fs) - errs} warnings")
            for f in fs:
                print(f"  {f['level']} {f['rule']} {f['file']}: {f['msg']} -> {f['fix']}")
    flat = [f for fs in res.values() for f in fs] if a.all else res
    sys.exit(1 if any(f["level"] == "error" for f in flat) else 0)



if __name__ == "__main__":
    main()
